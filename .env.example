# Stringa di connessione Neon (usare quella "pooled")
DATABASE_URL=postgresql://utente:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Opzionale: se impostata, l'API accetta solo richieste con questo token
# e la pagina va aperta una volta con ?token=IL_TUO_TOKEN
APP_TOKEN=
