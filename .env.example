# Serve solo per lavorare in locale: con l'integrazione Neon di Vercel queste variabili
# sono create automaticamente e si scaricano con "npx vercel env pull .env.local".

# Stringa di connessione Neon (usare quella "pooled")
DATABASE_URL=postgresql://utente:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Connessione diretta, usata dalle migrazioni
DATABASE_URL_UNPOOLED=postgresql://utente:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Opzionale: se impostata, l'API accetta solo richieste con questo token
# e la pagina va aperta una volta con ?token=IL_TUO_TOKEN
APP_TOKEN=
